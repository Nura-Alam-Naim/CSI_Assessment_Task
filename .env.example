# ==========================================
# FSE-01 Environment Configuration Template
# ==========================================
# Copy this file to `.env` before running the application:
# cp .env.example .env

# ------------------------------------------
# 1. HTTP Server Configuration
# ------------------------------------------
# The port that the Express REST API and static React frontend will run on.
PORT=3000

# ------------------------------------------
# 2. PostgreSQL Database Configuration
# ------------------------------------------
# The connection string for the main production/development database.
# Format: postgres://username:password@hostname:port/database_name
# If using the provided docker-compose.yml, the port is 5433 by default.
# If running a native local installation, you likely want port 5432.
DATABASE_URL=postgres://fse01_user:fse01_password@localhost:5433/fse01_db

# ------------------------------------------
# 3. Automated Testing Database
# ------------------------------------------
# A COMPLETELY ISOLATED database used strictly for the `npm test` suite.
# WARNING: The test suite runs TRUNCATE CASCADE commands against this DB. 
# NEVER point this to a production database.
TEST_DATABASE_URL=postgres://fse01_test_user:fse01_test_password@localhost:5433/fse01_test_db

# ------------------------------------------
# 4. MQTT Broker Integration
# ------------------------------------------
# The Candidate ID assigned by the examiner. This is heavily injected into 
# the client_id generation and the subscription topics (e.g. fse-01/09/challenge)
CANDIDATE_ID=09

# The network address of the central MQTT broker.
# Ensure this IP is reachable from your local network or VPN.
MQTT_URL=mqtt://152.42.238.142:1883
